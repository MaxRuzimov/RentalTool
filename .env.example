# Supabase (apps/web) — from your Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (apps/mobile) — same project/values as above, just re-prefixed for
# Expo's EXPO_PUBLIC_ convention (spec docs/design/m8-mobile-spec.md §9).
# Goes in apps/mobile/.env.local (gitignored), not this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
